{
  "name": "@nkomianos/switchboard",
  "version": "0.1.0",
  "description": "The attention router for your AI agents. One local inbox that decides when Claude Code, Codex, Cursor and any MCP agent get to interrupt you.",
  "type": "module",
  "bin": {
    "switchboard": "bin/switchboard.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "spec",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/switchboard.js start",
    "demo": "node bin/switchboard.js demo",
    "test": "node scripts/test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkomianos/switchboard.git"
  },
  "homepage": "https://github.com/nkomianos/switchboard#readme",
  "bugs": {
    "url": "https://github.com/nkomianos/switchboard/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "human-in-the-loop",
    "ask-human",
    "attention",
    "notifications",
    "approvals",
    "claude-code",
    "codex",
    "cursor",
    "openclaw",
    "telegram"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
